# ==============================================================================
# SkillGraph AI Configuration
# ==============================================================================

# Application & API
PROJECT_NAME="SkillGraph AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Database Configuration (SQLite default; PostgreSQL supported)
# SQLite: sqlite:///./data/skillgraph.db
# PostgreSQL: postgresql://skillgraph:password@localhost:5432/skillgraph_db
DATABASE_URL="sqlite:///./data/skillgraph.db"

# Storage Directories
DATA_DIR="./data"
MODELS_DIR="./models"

# CORS Configuration (JSON array or comma-separated list of origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Server Configuration
HOST="0.0.0.0"
PORT=8000
